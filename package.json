{
  "name": "@radyko/carrel",
  "productName": "Carrel",
  "version": "0.6.2",
  "description": "A quiet desktop app that guides you through reading research papers, and keeps your papers and notes as plain files.",
  "keywords": [
    "research",
    "papers",
    "reading",
    "notes",
    "electron",
    "pdf",
    "study"
  ],
  "license": "MIT",
  "main": "dist/node/main/main.js",
  "bin": {
    "carrel": "bin/carrel.js"
  },
  "files": [
    "bin",
    "dist",
    "guide",
    "scripts",
    "README.md",
    "docs",
    "assets/icon.png",
    "assets/icon.svg"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test",
    "install-app": "npm run build && node scripts/install-app.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "electron": "^44.5.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Radyko/carrel.git"
  },
  "homepage": "https://github.com/Radyko/carrel#readme"
}
